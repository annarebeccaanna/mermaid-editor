# Vorlage, um ein eigenes Supabase-Projekt zu verwenden: nach .env.local kopieren
# und die Werte eintragen (Project Settings -> API). .env.local überschreibt .env
# und ist nicht im Repo.
# Der Publishable Key ist für den Browser gedacht. Niemals den Secret-/Service-Role-Key eintragen.
VITE_SUPABASE_URL=https://<projekt>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
