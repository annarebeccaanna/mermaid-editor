{
  "name": "mermaid-editor",
  "productName": "Mermaid Editor",
  "version": "0.1.0",
  "description": "Desktop-App zum visuellen Zeichnen von Diagrammen mit sauberem Mermaid-Code als Ergebnis",
  "license": "MIT",
  "author": "annarebeccaanna",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "build": {
    "appId": "de.mermaid-editor.app",
    "productName": "Mermaid Editor",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "electron/**",
      "package.json"
    ],
    "fileAssociations": [
      {
        "ext": [
          "mmd",
          "mermaid"
        ],
        "name": "Mermaid Diagram",
        "role": "Editor"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Graphics"
    }
  },
  "dependencies": {
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@dagrejs/dagre": "^1.1.8",
    "@xyflow/react": "^12.12.0",
    "codemirror": "^6.0.2",
    "codemirror-lang-mermaid": "^0.5.0",
    "lucide-react": "^0.577.0",
    "mermaid": "^11.17.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^3.2.7",
    "wait-on": "^9.5.1"
  }
}
